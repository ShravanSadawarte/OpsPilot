generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
  TEAM_LEAD
  TEAM_MEMBER
}

enum WorkItemType {
  INCIDENT
  CUSTOMER_ISSUE
  ENGINEERING_TASK
  PAYMENT_INVESTIGATION
  COMPLIANCE_REQUEST
  OPERATIONAL_TASK
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENT_ADDED
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  name              String?
  passwordHash      String
  role              UserRole     @default(MEMBER)
  isActive          Boolean      @default(true)
  emailVerified     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships       TeamMembership[]
  workItemsAsReporter WorkItem[]  @relation("WorkItemReporter")
  workItemsAsAssignee WorkItem[]  @relation("WorkItemAssignee")
  comments          Comment[]
  activityEvents    ActivityEvent[] @relation("ActivityActor")
  approvalsRequested Approval[]     @relation("ApprovalRequester")
  approvalsDecided   Approval[]     @relation("ApprovalDecider")
  sessions          Session[]
  idempotencyRecords IdempotencyRecord[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Team {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships TeamMembership[]
  workItems   WorkItem[]

  @@index([key])
  @@index([isActive])
}

model TeamMembership {
  id        String      @id @default(uuid())
  teamId    String
  userId    String
  role      UserRole    @default(TEAM_MEMBER)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([teamId, isActive])
}

model WorkItem {
  id            String         @id @default(uuid())
  publicKey     String         @unique
  title         String
  description   String?
  type          WorkItemType
  status        WorkItemStatus @default(OPEN)
  priority      Priority       @default(MEDIUM)
  teamId        String
  assigneeId    String?
  reporterId    String
  dueDate       DateTime?
  version       Int            @default(1)
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  team          Team           @relation(fields: [teamId], references: [id])
  assignee      User?          @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter      User           @relation("WorkItemReporter", fields: [reporterId], references: [id])
  comments      Comment[]
  activityEvents ActivityEvent[]
  approvals     Approval[]

  @@index([teamId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([createdAt])
  @@index([publicKey])
  @@index([teamId, status])
  @@index([teamId, createdAt])
  @@index([teamId, assigneeId])
}

model Comment {
  id        String   @id @default(uuid())
  workItemId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItem  WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([workItemId])
  @@index([createdAt])
  @@index([workItemId, createdAt])
}

model ActivityEvent {
  id        String      @id @default(uuid())
  workItemId String
  actorId   String?
  type      ActivityType
  metadata  Json?
  createdAt DateTime    @default(now())

  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([createdAt])
  @@index([workItemId, createdAt])
}

model Approval {
  id            String         @id @default(uuid())
  workItemId    String
  requestedById String
  decidedById   String?
  status        ApprovalStatus @default(PENDING)
  reason        String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  workItem      WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([status])
  @@index([createdAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  actorId     String
  key         String
  fingerprint String
  statusCode  Int
  body        Json
  createdAt   DateTime @default(now())

  actor       User     @relation(fields: [actorId], references: [id])

  @@unique([actorId, key])
  @@index([actorId])
  @@index([createdAt])
}
