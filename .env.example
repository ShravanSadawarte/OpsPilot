# OpsPilot environment variables
# Copy this file to .env for local development.
# For Vercel, add each variable to Vercel Project Settings > Environment Variables.
# Never commit .env. Never prefix database URLs or secrets with NEXT_PUBLIC_.
# This file must contain placeholders only, never real credentials.

# =============================================================================
# REQUIRED AT RUNTIME (application)
# =============================================================================

# -----------------------------------------------------------------------------
# Managed PostgreSQL (Neon recommended as the primary provider)
# -----------------------------------------------------------------------------
# Pooled connection string used by the application at runtime (serverless).
# Neon example: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Supabase pooled example: postgresql://USER:PASSWORD@HOST:6543/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DB?sslmode=require"

# Direct (non-pooled) connection string used by Prisma migrate/seed.
# Neon example: postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
# Optional but recommended: falls back to DATABASE_URL when unset.
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication (custom session-based — see docs/SECURITY.md)
# -----------------------------------------------------------------------------
# Secret used to sign CSRF tokens (HMAC-SHA256). Required at runtime, not at
# build time. Generate with: openssl rand -base64 32
# Must be at least 32 characters. Rotate if compromised (invalidates CSRF tokens).
AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of the deployed application (e.g. https://your-app.vercel.app)
APP_URL="https://your-app.vercel.app"

# Node environment. Vercel sets this automatically; do not override on Vercel.
# NODE_ENV="production"

# Session lifetime in seconds (default 86400 = 1 day)
SESSION_TTL_SECONDS="86400"

# SameSite cookie mode: lax | strict | none
SESSION_COOKIE_SAMESITE="lax"

# Whether cookies should only be sent over HTTPS.
# Must be "true" on Vercel (HTTPS).
SESSION_COOKIE_SECURE="true"

# -----------------------------------------------------------------------------
# Security / rate limiting
# -----------------------------------------------------------------------------
# Max failed login attempts per window per identifier (email or IP)
LOGIN_RATE_LIMIT_MAX="5"

# Rate-limit window in seconds
LOGIN_RATE_LIMIT_WINDOW_SECONDS="300"

# =============================================================================
# TESTS AND SEEDING (never required in production)
# =============================================================================

# Dedicated database for integration tests. When unset, integration tests skip.
DATABASE_URL_TEST=""

# Required only for `npm run db:seed` when NODE_ENV=production (demo/staging).
# SEED_ALLOW_PRODUCTION="true"
